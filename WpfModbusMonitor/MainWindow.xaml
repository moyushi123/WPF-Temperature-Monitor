<Window x:Class="WpfModbusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Modbus TCP 温度监控"
        Width="640" Height="460"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Modbus TCP 温度监控"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="127.0.0.1:1502 · 站号1 · 输入寄存器0"
                       Foreground="Gray"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{Binding TemperatureDisplay}"
                       FontSize="28"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding StatusDisplay}" FontSize="16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="Gray"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusDisplay}"
                                         Value="状态：温度超限">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding StatusDisplay}"
                                         Value="状态：温度正常">
                                <Setter Property="Foreground"
                                        Value="ForestGreen"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding StatusDisplay}"
                                         Value="状态：读取失败">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Orientation="Horizontal"表示从左到右排列。 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <Button Content="读取一次"
                    Width="120" Height="38"
                    Margin="0,0,12,0"
                    Command="{Binding ReadCommand}"/>

            <Button Content="开始采集"
                    Width="120" Height="38"
                    Margin="0,0,12,0"
                    Command="{Binding StartCommand}"/>

            <Button Content="停止采集"
                    Width="120" Height="38"
                    Command="{Binding StopCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="3"
                 x:Name="LogList"
                 ItemsSource="{Binding Logs}"/>
    </Grid>
</Window>